# These variables can be set as environment variables when calling the docker build
# or by updating the value here. It is recommended to use an environment variables.
# If this file is updated, be sure to not commit it to the repository or otherwise
# make it public in any way.

# You must provide the entity guid for the browser app
NR_BROWSER_APP_GUID=${NR_BROWSER_APP_GUID:=''}

# OR the account id and either the app id or app name
NR_BROWSER_ACCOUNT_ID=${NR_BROWSER_ACCOUNT_ID:=''}
NR_BROWSER_APP_ID=${NR_BROWSER_APP_ID:=''}
NR_BROWSER_APP_NAME=${NR_BROWSER_APP_NAME:=''}

# You must provide a New Relic user key for the build
NR_USER_KEY=${NR_USER_KEY:=''}

# This is the New Relic GraphQL endpoint to be used
NR_GQL_ENDPOINT=${NR_GQL_ENDPOINT:='https://api.newrelic.com/graphql'}
